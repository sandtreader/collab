{
  "name": "@sandtreader/collab",
  "version": "0.1.0",
  "description": "Model-agnostic real-time collaboration: entity-document protocol, sequenced WebSocket relay, client, and React session UI",
  "license": "MIT",
  "repository": "github:sandtreader/collab",
  "type": "module",
  "files": ["dist"],
  "exports": {
    "./protocol": { "types": "./dist/protocol/index.d.ts", "import": "./dist/protocol/index.js" },
    "./client":   { "types": "./dist/client/index.d.ts",   "import": "./dist/client/index.js" },
    "./server":   { "types": "./dist/server/index.d.ts",   "import": "./dist/server/index.js" },
    "./react":    { "types": "./dist/react/index.d.ts",    "import": "./dist/react/index.js" }
  },
  "bin": { "collab-relay": "./dist/server/bin.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "relay": "tsx src/server/bin.ts"
  },
  "peerDependencies": {
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "@mui/icons-material": ">=6",
    "@mui/material": ">=6",
    "bad-words": ">=4",
    "qrcode.react": ">=4",
    "react": ">=18",
    "ws": ">=8"
  },
  "peerDependenciesMeta": {
    "@emotion/react": { "optional": true },
    "@emotion/styled": { "optional": true },
    "@mui/icons-material": { "optional": true },
    "@mui/material": { "optional": true },
    "bad-words": { "optional": true },
    "qrcode.react": { "optional": true },
    "react": { "optional": true },
    "ws": { "optional": true }
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.18.1",
    "bad-words": "^4.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5",
    "ws": "^8.20.0"
  },
  "engines": { "node": ">=20" }
}
